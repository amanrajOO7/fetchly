<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        A download glyph (arrow into a tray), scaled up and centered from Material's 24x24
        "download" icon. Scaling pivots on the glyph's own center (12,12) so it stays centered
        after the resize, then the group is translated so that point lands on the 108x108
        viewport's center (54,54). The resulting glyph sits well inside the ~66dp safe zone that
        every launcher mask shape (circle, squircle, rounded square) leaves unclipped.
    -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="2.2"
        android:scaleY="2.2"
        android:translateX="42"
        android:translateY="42">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M19,9h-4V3H9v6H5l7,7l7,-7zM5,18v2h14v-2H5z" />
    </group>
</vector>
